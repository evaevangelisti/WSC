<View>
  <Header value="$headword"/>
  <HyperText name="entry" value="&lt;a href='$url' target='_blank'&gt;Open the entry&lt;/a&gt;" inline="true"/>

  <Header value="Sense"/>
  <Text name="gloss" value="$gloss"/>

  <Header value="Sentence, with every occurrence found in bold"/>
  <HyperText name="sentence" value="$marked" inline="true"/>

  <Header value="Are the occurrences in bold the right ones?"/>
  <Choices name="verdict" toName="sentence" choice="single" required="true">
    <Choice value="all right"/>
    <Choice value="one was missed"/>
    <Choice value="one is not the headword"/>
    <Choice value="one stops in the wrong place"/>
    <Choice value="not in the sentence"/>
  </Choices>

  <Header value="Does the marked word carry the part of speech of the sense?"/>
  <Choices name="pos_verdict" toName="sentence" choice="single" required="true" showInline="true">
    <Choice value="it does"/>
    <Choice value="it does not"/>
    <Choice value="nothing marked"/>
  </Choices>

  <TextArea name="notes" toName="sentence" rows="2" placeholder="anything the labels miss"/>
</View>
